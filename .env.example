# ---- Scraper ----
# Data comes from Safeway's weekly ad via Flipp (backflipp.wishabi.com), which
# is plain JSON with no bot-wall — so on a normal network NO key is required.
# Only set this if you're on a network-restricted host (it routes Flipp
# requests through Firecrawl). Get a key at https://firecrawl.dev.
FIRECRAWL_API_KEY=

# ---- Email alerts (pluggable) ----
# Pick ONE provider. If none is set, the scraper runs in "console" mode and
# just prints the alert instead of sending it.
#
# Resend (https://resend.com) — simplest, generous free tier:
RESEND_API_KEY=
ALERT_FROM="Scoop Alert <alerts@yourdomain.com>"
ALERT_TO=justin.kuzmanich@gmail.com
